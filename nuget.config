<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The Esiipayment SDK is not on nuget.org yet (that needs a Trusted
      Publishing policy configured there first). Until then it resolves from
      a local folder feed: clone miki-smart/esiipayment-dotnet as a sibling
      of this repo and run its pack-local.ps1.

      Once the packages are published, delete this source and change the
      versions in the .csproj from 2.0.0-local to the released version.
    -->
    <add key="esiipayment-local" value="../esiipayment-local-feed" />
  </packageSources>
</configuration>
