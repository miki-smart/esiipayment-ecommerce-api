<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      nuget.org only. The Esiipayment SDK is published there, so this repo
      needs no local folder feed, no sibling clone of esiipayment-dotnet, and
      no spec-repo submodule.

      <clear /> is deliberate: it drops any machine-wide sources from the
      user's global NuGet.Config, so a restore here resolves the same way on
      every machine and in CI.

      To test an unreleased SDK build, do not edit this file — run
      pack-local.ps1 in esiipayment-dotnet and add its feed for that restore
      only:  dotnet restore -s https://api.nuget.org/v3/index.json -s ../esiipayment-local-feed
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
