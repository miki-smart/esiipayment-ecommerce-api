<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Esiipayment SDK is consumed as a package from nuget.org, not as
    source. Esiipayment.Providers carries the provider manifests, so this repo
    needs no spec-repo checkout or submodule.

    Versions are pinned exactly rather than floating (2.0.*): this is a
    payments integration, so an SDK upgrade should be a reviewed commit that
    CI runs against, never something a restore picks up on its own.

    All three move together — the manifests in Esiipayment.Providers are
    versioned alongside the runtime that was conformance-tested against them.
  -->
  <ItemGroup>
    <PackageReference Include="Esiipayment.Core" Version="2.0.0-preview.1" />
    <PackageReference Include="Esiipayment.AspNetCore" Version="2.0.0-preview.1" />
    <PackageReference Include="Esiipayment.Providers" Version="2.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>97099132-8bf1-4d6a-a11e-163130ad2426</UserSecretsId>
  </PropertyGroup>

</Project>
