<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Esiipayment SDK is consumed as a package from nuget.org, not as
    source. Esiipayment.Providers carries the provider manifests, so this repo
    needs no spec-repo checkout or submodule.

    Versions are pinned exactly rather than floating (2.0.*): this is a
    payments integration, so an SDK upgrade should be a reviewed commit that
    CI runs against, never something a restore picks up on its own.

    They all move together — the manifests in Esiipayment.Providers are
    versioned alongside the runtime that was conformance-tested against them.

    Esiipayment.Providers.Telebirr is the native provider implementation:
    Telebirr signs a canonicalized parameter string on every request, which the
    manifest DSL deliberately cannot express, so its behaviour is code rather
    than data (spec/03-manifest-dsl.md#native-providers). Each native provider
    is a separate package, so an application that never touches Telebirr does
    not carry its implementation.

    2.1.0-preview.1 is the first SDK version with the IPaymentClient seam that
    lets a native provider be reached through the same surface as a
    manifest-driven one. Until it is published, restore against a local feed:
        (in esiipayment-dotnet)  ./pack-local.ps1 -Version 2.1.0-preview.1
        (here)                   dotnet restore -s https://api.nuget.org/v3/index.json -s ../esiipayment-local-feed
  -->
  <ItemGroup>
    <PackageReference Include="Esiipayment.Core" Version="2.1.0-preview.1" />
    <PackageReference Include="Esiipayment.AspNetCore" Version="2.1.0-preview.1" />
    <PackageReference Include="Esiipayment.Providers" Version="2.1.0-preview.1" />
    <PackageReference Include="Esiipayment.Providers.Telebirr" Version="2.1.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>97099132-8bf1-4d6a-a11e-163130ad2426</UserSecretsId>
  </PropertyGroup>

</Project>
