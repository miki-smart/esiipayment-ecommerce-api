<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Esiipayment SDK is consumed as a package, not as source. Until it is
    published to nuget.org it resolves from the local feed registered in
    ../../nuget.config — run pack-local.ps1 in the esiipayment-dotnet repo
    to populate it. Esiipayment.Providers carries the provider manifests, so
    this repo needs no spec-repo checkout or submodule.
  -->
  <ItemGroup>
    <PackageReference Include="Esiipayment.Core" Version="2.0.0-local" />
    <PackageReference Include="Esiipayment.AspNetCore" Version="2.0.0-local" />
    <PackageReference Include="Esiipayment.Providers" Version="2.0.0-local" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>97099132-8bf1-4d6a-a11e-163130ad2426</UserSecretsId>
  </PropertyGroup>

</Project>
